   "source": [
    "log = []\n",
    "def check(area, test, result, status, action=''):\n",
    "    log.append(dict(area=area, test=test, result=str(result), status=status, action=action))\n",
    "ok = lambda b: 'PASS' if b else 'FAIL'\n",
    "\n",
    "# --- row counts and keys\n",
    "exp = {'districts': 24, 'age_sex': 24 * 18 * 2, 'life_table_inputs': 18, 'projection_scenarios': 3, 'insured_transitions': 24 * 2 * 2}\n",
    "for n, d in [('districts', districts), ('age_sex', age_sex), ('life_table_inputs', life_in), ('projection_scenarios', scen), ('insured_transitions', ins)]:\n",
    "    check('Row count', n, f'{len(d)} (expected {exp[n]})', ok(len(d) == exp[n]))\n",
    "check('Key', 'districts.district_id unique', districts.district_id.is_unique, ok(districts.district_id.is_unique))\n",
    "check('Key', 'age_sex (district_id, age_start, sex) unique', not age_sex.duplicated(['district_id', 'age_start', 'sex']).any(), ok(not age_sex.duplicated(['district_id', 'age_start', 'sex']).any()))\n",
    "check('Key', 'life_table age_start unique', life_in.age_start.is_unique, ok(life_in.age_start.is_unique))\n",
    "check('Key', 'projection_scenarios scenario unique', scen.scenario.is_unique, ok(scen.scenario.is_unique))\n",
    "check('Key', 'insured (district_id, origin, destination) unique', not ins.duplicated(['district_id', 'origin', 'destination']).any(), ok(not ins.duplicated(['district_id', 'origin', 'destination']).any()))\n",
    "\n",
    "# --- join cardinality: age_sex (many) -> districts (one)\n",
    "j = age_sex.merge(districts[['district_id']], on='district_id', how='left', validate='many_to_one', indicator=True)\n",
    "check('Join', 'age_sex -> districts is many-to-one, no orphans, no row inflation', f'{len(j)} rows after join, orphans={(j._merge != \"both\").sum()}', ok(len(j) == len(age_sex) and (j._merge == 'both').all()))\n",
    "per_d = age_sex.groupby('district_id').size()\n",
    "check('Join', 'rows per district in age_sex', f'min={per_d.min()}, max={per_d.max()}', ok((per_d == 36).all()))\n",
    "ji = ins.merge(districts[['district_id']], on='district_id', how='left', validate='many_to_one')\n",
    "check('Join', 'insured_transitions -> districts many-to-one (4 rows per district)', f'{len(ji)} rows; rows per district = {ins.groupby(\"district_id\").size().unique().tolist()}', ok(len(ji) == len(ins)))\n",
    "\n",
    "# --- coverage\n",
    "cov = age_sex.groupby('district_id').agg(bands=('age_start', 'nunique'), sexes=('sex', 'nunique'))\n",
    "check('Coverage', 'age bands 0..85 (18) and sexes F,M in every district', f'bands={cov.bands.unique().tolist()}, sexes={cov.sexes.unique().tolist()}', ok((cov.bands == 18).all() and (cov.sexes == 2).all()))\n",
    "check('Coverage', 'age_start values', AGES, ok(AGES == list(range(0, 90, 5))))\n",
    "check('Coverage', 'life-table bands match age_sex bands', life_in.age_start.tolist() == AGES, ok(life_in.age_start.tolist() == AGES))\n",
    "\n",
    "# --- missing indicators\n",
    "miss = pd.concat([d.isna().sum().rename(n) for n, d in [('districts', districts), ('age_sex', age_sex), ('life', life_in), ('scen', scen), ('ins', ins)]], axis=1)\n",
    "miss_list = {c: districts.loc[districts[c].isna(), 'district_id'].tolist() for c in districts.columns if districts[c].isna().any()}\n",
    "check('Missing', 'districts.piped_water_pct missing', miss_list, 'FLAG', 'Left blank in raw data. Imputed ONLY in the clustering step (Section 4) with an explicit flag column; sensitivity checked.')\n",
    "check('Missing', 'age_sex, scenarios, insured: any blanks', int(age_sex.isna().sum().sum() + scen.isna().sum().sum() + ins.isna().sum().sum()), ok(age_sex.isna().sum().sum() + scen.isna().sum().sum() + ins.isna().sum().sum() == 0))\n",
    "lt_blank = life_in[life_in.interval_years.isna() | life_in.ax.isna()].age_start.tolist()\n",
    "check('Missing', 'life table blanks (interval_years, ax)', f'only at age_start={lt_blank}', ok(lt_blank == [85]), 'Structural (open interval). Handled via L85+ = l85/m85+.')\n",
    "\n",
    "# --- valid ranges\n",
    "num_cols = ['population_2025', 'baseline_deaths_2025', 'arrivals_2025', 'departures_2025', 'births_to_women_2025']\n",
    "check('Range', 'age_sex counts non-negative integers', bool((age_sex[num_cols] >= 0).all().all()), ok((age_sex[num_cols] >= 0).all().all()))\n",
    "check('Range', 'survival_5yr in (0,1]', f'{age_sex.survival_5yr.min():.4f} to {age_sex.survival_5yr.max():.4f}', ok(age_sex.survival_5yr.between(0, 1).all()))\n",
    "check('Range', 'baseline deaths <= population', bool((age_sex.baseline_deaths_2025 <= age_sex.population_2025).all()), ok((age_sex.baseline_deaths_2025 <= age_sex.population_2025).all()))\n",
    "fb = age_sex[age_sex.births_to_women_2025 > 0]\n",
    "check('Range', 'births only in female rows, ages 15-49', f'male rows with births={(age_sex[(age_sex.sex==\"M\")].births_to_women_2025>0).sum()}; ages with births={sorted(fb.age_start.unique())}', ok((fb.sex == 'F').all() and fb.age_start.between(15, 45).all()))\n",
    "check('Range', 'piped_water_pct within 0-100', f'{districts.piped_water_pct.min()} to {districts.piped_water_pct.max()}', ok(districts.piped_water_pct.dropna().between(0, 100).all()))\n",
    "check('Range', 'life table ax within (0, interval)', 'all 5-year bands', ok(((life_in.ax > 0) & (life_in.ax < life_in.interval_years)).iloc[:-1].all()))\n",
    "check('Range', 'scenario multipliers positive, newborn survival in (0,1)', 'Low<Base<High ordering holds for fertility, arrivals, newborn survival', ok(scen.fertility_multiplier.is_monotonic_increasing and scen.arrivals_multiplier.is_monotonic_increasing and scen.departures_multiplier.is_monotonic_decreasing))\n",
    "\n",
    "# --- reconciliation of totals and events\n",
    "agg = age_sex.groupby('district_id').agg(pop2025=('population_2025', 'sum'), base_deaths=('baseline_deaths_2025', 'sum'),\n",
    "        arr=('arrivals_2025', 'sum'), dep=('departures_2025', 'sum'), births_f=('births_to_women_2025', 'sum'))\n",
    "rec = districts.merge(agg, left_on='district_id', right_index=True, validate='one_to_one')\n",
    "rec['recon_2026'] = rec.pop2025 + rec.births_2025 - rec.deaths_2025 + rec.arrivals_2025 - rec.departures_2025\n",
    "rec['balance_gap'] = rec.population_2026 - rec.recon_2026\n",
    "rec['newborn_deaths_implied'] = rec.deaths_2025 - rec.base_deaths\n",
    "check('Reconcile', 'births: districts vs sum of age_sex female rows', f'max abs diff = {(rec.births_2025 - rec.births_f).abs().max()}', ok((rec.births_2025 == rec.births_f).all()))\n",
    "check('Reconcile', 'arrivals: districts vs age_sex', f'max abs diff = {(rec.arrivals_2025 - rec.arr).abs().max()}', ok((rec.arrivals_2025 == rec.arr).all()))\n",
    "check('Reconcile', 'departures: districts vs age_sex', f'max abs diff = {(rec.departures_2025 - rec.dep).abs().max()}', ok((rec.departures_2025 == rec.dep).all()))\n",
    "check('Reconcile', 'balancing equation: P2025 + B - D + I - E = reported P2026', f'max abs gap = {rec.balance_gap.abs().max()} persons', ok((rec.balance_gap == 0).all()))\n",
    "check('Reconcile', 'district deaths vs baseline deaths (scope difference)', f'district deaths exceed baseline deaths in {(rec.newborn_deaths_implied>0).sum()}/24 districts; total gap = {rec.newborn_deaths_implied.sum():,}', 'EXPLAINED',\n",
    "      'Baseline deaths cover only residents present on 1 Jan 2025 (classified by baseline age). District deaths also include deaths among 2025 births. The gap is therefore the implied deaths of 2025 births and must NOT be treated as an error.')\n",
    "\n",
    "# --- Markov file repeated-field conventions\n",
    "rep = ins.groupby(['district_id', 'origin']).agg(n_exp=('exposure_py', 'nunique'), n_init=('initial_lives', 'nunique'), rows=('destination', 'size'))\n",
    "check('Markov file', 'exposure_py and initial_lives repeated identically across the 2 destinations', f'unique values per district-origin: exposure={rep.n_exp.unique().tolist()}, initial={rep.n_init.unique().tolist()}, rows={rep.rows.unique().tolist()}', ok((rep.n_exp == 1).all() and (rep.n_init == 1).all()),\n",
    "      'Count exposure and initial_lives ONCE per district-origin (drop_duplicates) to avoid double counting.')\n",
    "check('Markov file', 'origins/destinations valid (H->I,D ; I->H,D)', sorted(set(zip(ins.origin, ins.destination))), ok(set(zip(ins.origin, ins.destination)) == {('H', 'I'), ('H', 'D'), ('I', 'H'), ('I', 'D')}))\n",
    "check('Markov file', 'counts non-negative; exposure positive', f'min exposure={ins.exposure_py.min()}', ok((ins.transition_count >= 0).all() and (ins.exposure_py > 0).all()))\n",
    "check('Cleaning', 'Original CSVs unchanged; no rows dropped', 'All derived tables are built in memory and exported separately to outputs/', 'DONE')\n",
    "\n",
    "dq = pd.DataFrame(log)\n",
    "dq.to_csv(OUT / 'data_quality_log.csv', index=False)\n",
    "KEY['dq_pass'] = int((dq.status == 'PASS').sum()); KEY['dq_total'] = len(dq); KEY['dq_fail'] = int((dq.status == 'FAIL').sum())\n",
    "dq"
   ]
  },
