   "source": [
    "lt = life_in.copy()\n",
    "lt['n'] = lt.interval_years\n",
    "lt['mx'] = lt.deaths / lt.person_years\n",
    "N = len(lt); qx = np.zeros(N); lx = np.zeros(N); dx = np.zeros(N); Lx = np.zeros(N)\n",
    "for i in range(N):\n",
    "    if i < N - 1:\n",
    "        qx[i] = lt.n[i] * lt.mx[i] / (1 + (lt.n[i] - lt.ax[i]) * lt.mx[i])\n",
    "    else:\n",
    "        qx[i] = 1.0\n",
    "lx[0] = 100000\n",
    "for i in range(N):\n",
    "    dx[i] = lx[i] * qx[i]\n",
    "    if i < N - 1: lx[i + 1] = lx[i] - dx[i]\n",
    "for i in range(N):\n",
    "    Lx[i] = lt.n[i] * lx[i + 1] + lt.ax[i] * dx[i] if i < N - 1 else lx[i] / lt.mx[i]\n",
    "Tx = np.cumsum(Lx[::-1])[::-1]\n",
    "lt['qx'], lt['lx'], lt['dx'], lt['Lx'], lt['Tx'] = qx, lx, dx, Lx, Tx\n",
    "lt['ex'] = lt.Tx / lt.lx\n",
    "lt['age'] = lt.age_start.map(AGE_LAB)\n",
    "life_table = lt[['age', 'age_start', 'person_years', 'deaths', 'mx', 'qx', 'lx', 'dx', 'Lx', 'Tx', 'ex']]\n",
    "print(life_table.round({'mx': 5, 'qx': 5, 'lx': 1, 'dx': 1, 'Lx': 1, 'Tx': 1, 'ex': 2}).to_string(index=False))"
   ]
  },
