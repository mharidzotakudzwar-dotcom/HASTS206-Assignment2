    "sel = rec.set_index('district_id').loc[[SEL_Y, SEL_O]].copy()\n",
    "sel['exposure'] = (sel.pop2025 + sel.population_2026) / 2\n",
    "sel['CBR'] = 1000 * sel.births_2025 / sel.exposure\n",
    "sel['CDR'] = 1000 * sel.deaths_2025 / sel.exposure\n",
    "sel['NMR'] = 1000 * (sel.arrivals_2025 - sel.departures_2025) / sel.exposure\n",
    "sel['NIR'] = sel.CBR - sel.CDR\n",
    "sel['growth_per_1000'] = sel.NIR + sel.NMR\n",
    "sel['growth_pct'] = sel.growth_per_1000 / 10\n",
    "sel['check_growth_pct'] = 100 * (sel.population_2026 / sel.pop2025 - 1)\n",
    "cols = ['pop2025', 'births_2025', 'deaths_2025', 'arrivals_2025', 'departures_2025', 'recon_2026', 'population_2026', 'balance_gap', 'exposure']\n",
