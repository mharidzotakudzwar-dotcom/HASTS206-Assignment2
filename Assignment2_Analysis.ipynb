    "def structure(df):\n",
    "    \"\"\"Age-structure indicators for one district's age_sex rows (1 Jan 2025).\"\"\"\n",
    "    p = df.groupby('age_start').population_2025.sum()\n",
    "    sx = df.groupby('sex').population_2025.sum()\n",
    "    tot = p.sum(); kids = p[p.index < 15].sum(); work = p[(p.index >= 15) & (p.index < 65)].sum(); old = p[p.index >= 65].sum()\n",
    "    return dict(pop2025=tot, females=sx['F'], males=sx['M'], sex_ratio=100 * sx['M'] / sx['F'], share_u15=kids / tot, share_65p=old / tot,\n",
    "                ydr=100 * kids / work, odr=100 * old / work, ageing_index=100 * old / kids)\n",
    "\n",
    "struct = pd.DataFrame({d: structure(g) for d, g in age_sex.groupby('district_id')}).T\n",
    "struct.index.name = 'district_id'\n",
    "\n",
    "cands = []\n",
    "ids = struct.index.tolist()\n",
    "for i in range(len(ids)):\n",
    "    for k in range(i + 1, len(ids)):\n",
    "        a, b = ids[i], ids[k]\n",
    "        if abs(struct.pop2025[a] - struct.pop2025[b]) / max(struct.pop2025[a], struct.pop2025[b]) < 0.02:\n",
    "            cands.append((a, b, abs(struct.ageing_index[a] - struct.ageing_index[b])))\n",
    "cands = pd.DataFrame(cands, columns=['district_a', 'district_b', 'ageing_index_gap']).sort_values('ageing_index_gap', ascending=False)\n",
    "print(cands.head(5).to_string(index=False))\n",
    "SEL_A, SEL_B = cands.iloc[0].district_a, cands.iloc[0].district_b\n",
    "# order so that SEL_Y is the young district and SEL_O the ageing one\n",
    "SEL_Y, SEL_O = sorted([SEL_A, SEL_B], key=lambda d: -struct.share_u15[d])\n",
    "print(f'\\nSelected: young district = {SEL_Y}, ageing district = {SEL_O}')\n",
    "struct.loc[[SEL_Y, SEL_O]].T"
   ]
  },
