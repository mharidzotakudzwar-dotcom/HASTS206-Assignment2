    "def trend_models(d):\n",
    "    p0, p5, p6 = pop20[d], pop25[d], pop26[d]\n",
    "    g = (p5 - p0) / 5; r = (p5 / p0) ** (1 / 5) - 1\n",
    "    return dict(district_id=d, P2020=p0, P2025=p5, P2026_reported=p6, arith_annual_change=g, geom_rate=r,\n",
    "                arith_2026=p5 + g, geom_2026=p5 * (1 + r), arith_2030=p5 + 5 * g, geom_2030=p5 * (1 + r) ** 5)\n",
    "trend_all = pd.DataFrame([trend_models(d) for d in districts.district_id])\n",
    "tr = trend_all.set_index('district_id').loc[[PROJ]].T\n",
    "print(f'Projection district: {PROJ}'); print(tr.to_string())\n",
    "t = trend_all.set_index('district_id').loc[PROJ]\n",
    "print(f'\\nBack-test against the reported 1 Jan 2026 stock ({t.P2026_reported:,.0f}):')\n",
    "print(f'  arithmetic 2026 = {t.arith_2026:,.0f} (error {t.arith_2026 - t.P2026_reported:+,.0f});  geometric 2026 = {t.geom_2026:,.0f} (error {t.geom_2026 - t.P2026_reported:+,.0f})')\n",
    "KEY['trend'] = {k: float(v) for k, v in t.items() if k != 'district_id'}"
   ]
