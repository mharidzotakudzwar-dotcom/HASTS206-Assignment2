    "import json, warnings\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.patches import Circle, FancyArrowPatch\n",
    "from scipy.linalg import expm\n",
    "from sklearn.cluster import KMeans\n",
    "from sklearn.metrics import silhouette_score, silhouette_samples, adjusted_rand_score\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "pd.options.display.float_format = lambda v: f'{v:,.0f}' if float(v).is_integer() else f'{v:,.4f}'\n",
    "pd.options.display.width = 200\n",
    "pd.options.display.max_columns = 40\n",
    "plt.rcParams.update({'figure.dpi': 100, 'axes.grid': True, 'grid.alpha': .3, 'axes.spines.top': False, 'axes.spines.right': False})\n",
    "\n",
    "DATA, OUT = Path('data'), Path('outputs')\n",
    "FIG = OUT / 'figures'\n",
    "FIG.mkdir(parents=True, exist_ok=True)\n",
    "HYP = '(hypothetical data)'\n",
    "f0 = lambda x: f'{x:,.0f}'; f1 = lambda x: f'{x:,.1f}'; f2 = lambda x: f'{x:,.2f}'; f3 = lambda x: f'{x:,.3f}'; f4 = lambda x: f'{x:,.4f}'; pc = lambda x: f'{100*x:.1f}%'   # formatting helpers used in the Notes cells\n",
    "KEY = {}          # key results saved to outputs/key_results.json for the PDF report\n",
    "\n",
    "districts = pd.read_csv(DATA / 'districts.csv')\n",
    "age_sex   = pd.read_csv(DATA / 'age_sex.csv')\n",
    "life_in   = pd.read_csv(DATA / 'life_table_inputs.csv')\n",
    "scen      = pd.read_csv(DATA / 'projection_scenarios.csv')\n",
    "ins       = pd.read_csv(DATA / 'insured_transitions.csv')\n",
    "\n",
    "AGES = sorted(age_sex.age_start.unique())\n",
    "AGE_LAB = {a: (f'{a}-{a+4}' if a < 85 else '85+') for a in AGES}\n",
    "for n, d in [('districts', districts), ('age_sex', age_sex), ('life_table_inputs', life_in), ('projection_scenarios', scen), ('insured_transitions', ins)]:\n",
